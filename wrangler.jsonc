// The Cloudflare Worker that serves the web game at https://forfuckssake.today
// (Documentation/mvp/delivery.md). The built game in web/dist/ is static assets; worker/index.js sends
// www.forfuckssake.today to the bare domain and hands everything else to the assets.
// Deployed by .github/workflows/release.yml on a v* tag, or by hand with `make deploy`
// (needs CLOUDFLARE_API_TOKEN). Signing in is icelander.net's login service (docs/accounts.md there): the ACCOUNTS
// service binding below (the same Cloudflare account), the service's public keys in ACCOUNTS_JWKS, and the app
// "ffs" registered there with the callback https://forfuckssake.today/auth/callback. No secret is needed here.
{
  "name": "for-fucks-sake",
  "account_id": "ab026008f5aa2bef2dca4cfccd0f70ef",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // the script sees every request first, so it can redirect www before an asset (index.html) matches
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "forfuckssake.today", "custom_domain": true },
    { "pattern": "www.forfuckssake.today", "custom_domain": true }
  ],
  "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "Internal" }],
  "vars": {
    "ACCOUNTS_JWKS": "{\"keys\":[{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"kid\":\"k2026a\",\"x\":\"WIEomi0LTalJvQndhD7abl8ty3YcliQ0vEz4XjLXayc\"}]}"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
